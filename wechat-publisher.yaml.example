# wechat-publisher unified config example
# Copy this file to wechat-publisher.yaml and fill in your own credentials.
# Do not commit wechat-publisher.yaml.

default: main

accounts:
  main:
    name: "你的公众号名称"
    app_id: "wx0000000000000000"
    app_secret: "replace_with_your_official_account_app_secret"
    author: "作者名"
    theme: "refined-blue"
    image_style: "hand-drawn-blue"
    newspic_image_style: "infographic-warm"
    voice: |
      在这里写这个公众号的语气说明。
      例如:目标读者、口吻、常用表达、禁用表达、文章长度偏好。

  # Optional second account. Delete this block if you only have one account.
  tech:
    name: "你的技术公众号名称"
    app_id: "wx1111111111111111"
    app_secret: "replace_with_another_official_account_app_secret"
    author: "作者名"
    theme: "minimal-mono"
    image_style: "tech-card-blue"
    newspic_image_style: "infographic-blue"
    voice: |
      在这里写第二个公众号的语气说明。

image_generation:
  # Available values:
  # - baoyu-image-gen
  # - baoyu-danger-gemini-web
  generator: "baoyu-image-gen"

  # Optional OpenAI image backend
  openai:
    api_key: ""
    base_url: "https://api.openai.com/v1"
    image_model: "gpt-image-1"

  # Optional Gemini-compatible proxy backend
  gemini_proxy:
    base_url: "https://generativelanguage.googleapis.com"
    api_key: ""
    image_model: "gemini-2.5-flash"

  # Optional Gemini Web backend
  gemini_web:
    # data_dir: "/path/to/gemini-web-data"
    # cookie_path: "/path/to/cookies.json"
    # chrome_profile_dir: "/path/to/chrome-profile"
    # chrome_path: "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

integrations:
  # Optional: @wechatsync/cli + browser extension MCP token
  wechatsync_mcp_token: ""
